# Create these as Vercel Production environment variables. Never commit real values.
LITELLM_MASTER_KEY=sk-replace-with-a-long-random-secret
LITELLM_SALT_KEY=sk-replace-with-a-different-long-random-secret
UI_USERNAME=admin
UI_PASSWORD=replace-with-a-unique-long-random-password
DEEPSEEK_API_KEY=replace-with-your-deepseek-api-key
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
