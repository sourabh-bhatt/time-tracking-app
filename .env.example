USER_ID=sourabh
TRACKING_TIMEZONE=America/New_York
TRACKING_TIME_LABEL=Eastern Time
AWS_REGION=us-east-1
AWS_S3_BUCKET=your-time-tracker-bucket
AWS_S3_PREFIX=time-tracker
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
MONGODB_URI=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=

# Web server only (.env.local / deployment environment). Never ship in desktop builds.
# Generate a random secret: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SESSION_SECRET=
# Generate each hash with: npm run auth:hash-password
AUTH_ADMIN_PASSWORD_HASH=
AUTH_SOURABH_PASSWORD_HASH=
AUTH_PRAYASH_PASSWORD_HASH=

# Desktop configuration belongs in .env.desktop; include only USER_ID, TRACKING_*,
# ON_CALL_*, and AWS_* variables. Use an employee-scoped IAM identity.
