{
  "name": "employee-monitor",
  "version": "1.0.0",
  "description": "Employee monitoring app with screenshots and input tracking",
  "main": "main.js",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start:next": "next start",
    "start": "electron .",
    "build:electron": "electron-builder",
    "build:linux": "electron-builder --linux AppImage deb",
    "build:linux:arm64": "electron-builder --linux AppImage deb --arm64",
    "build:linux:arm64:appimage": "electron-builder --linux AppImage --arm64",
    "build:portable-win": "node scripts/build-portable-win.js",
    "lint": "eslint",
    "migrate:s3": "node scripts/migrate-mongo-to-s3.js",
    "test": "node --test tests/*.test.js",
    "verify:desktop": "electron scripts/verify-desktop.js",
    "auth:hash-password": "node scripts/hash-password.js"
  },
  "keywords": [],
  "author": {
    "name": "Beyond Billions",
    "email": "support@beyondbillions.com"
  },
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1024.0",
    "cors": "^2.8.5",
    "dotenv": "^17.4.0",
    "express": "^5.2.1",
    "googleapis": "^169.0.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.2",
    "mongodb": "^7.0.0",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "screenshot-desktop": "^1.15.0",
    "uiohook-napi": "^1.5.4"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "electron": "^45.3.3",
    "electron-builder": "^26.18.0",
    "eslint": "^9",
    "eslint-config-next": "^16.4.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "build": {
    "appId": "com.beyondbillions.tracker",
    "productName": "Time Tracker",
    "npmRebuild": false,
    "nodeGypRebuild": false,
    "buildDependenciesFromSource": false,
    "directories": {
      "output": "dist"
    },
    "icon": "public/time-tracker-linux.png",
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "zip"
    },
    "linux": {
      "icon": "public/time-tracker-linux.png",
      "target": [
        "AppImage",
        "deb"
      ],
      "maintainer": "Beyond Billions <support@beyondbillions.com>",
      "category": "Utility"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer.js",
      "index.html",
      "styles.css",
      "lib/s3-storage.js",
      "lib/windows-capture.js",
      "public/**/*",
      ".env.desktop",
      "package.json"
    ]
  }
}
